mydict = {"name": "Max", "age": 28, "city": "New York"}
print(mydict) # prints the entire dictionary

mydict2 = dict(name = "Mary", age = 27, city = "Boston") # another way to create a dictionary
print(mydict2) # prints the entire dictionary

val = mydict["name"] # get the value of the key "name"
print(val) # prints Max

mydict["email"] = "max@abc.com" # add a new key-value pair to the dictionary
print(mydict) # prints the entire dictionary

del mydict["age"] # remove the key-value pair with the key "age"
print(mydict) # prints the entire dictionary

mydict.pop("name")
print(mydict)

if "name" in mydict:
    print(mydict["lastname"])
else:
    print("Key 'name' not found in the dictionary")

